NODE_ENV=development
PORT=5080
WEB_ORIGIN=http://localhost:4200
JWT_SECRET=replace-with-at-least-32-random-bytes
OWNER_EMAIL=owner@example.com

# Central control-plane database: users, store registry, subscriptions and permissions.
TURSO_CONTROL_DATABASE_URL=libsql://your-control-db.turso.io
TURSO_CONTROL_AUTH_TOKEN=replace-me

# Turso Platform API is needed to provision a dedicated database for each store.
TURSO_PLATFORM_TOKEN=replace-me
TURSO_ORGANIZATION=your-turso-organization
TURSO_GROUP=default
TURSO_LOCATION=aws-ap-south-1
DATABASE_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Optional first tenant DB bootstrap, if it has already been provisioned.
BOOTSTRAP_STORE_CODE=MAIN
BOOTSTRAP_STORE_NAME=Main Store
BOOTSTRAP_STORE_DATABASE_URL=
BOOTSTRAP_STORE_AUTH_TOKEN=
BOOTSTRAP_OWNER_PASSWORD=
