{
  "framework": "angular",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/web/browser",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://medical-store-api-exdrhca4hwc9dugx.southeastasia-01.azurewebsites.net/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
